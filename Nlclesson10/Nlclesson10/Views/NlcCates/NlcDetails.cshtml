@model Nlclesson10.Models.NlcCate

@{
    ViewData["Title"] = "xem thong tin";
}




    



<div class="row">
    <div class="col-md-6">
       
            <div class="card">

                <div class="card-header">

                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                </div>
                <div class="card-body">

                    <div class="form-group">
                        <label asp-for="CatId" class="control-label"></label>
                        <input asp-for="CatId" class="form-control" readonly />
                        
                    </div>
                    <div class="form-group">
                        <label asp-for="CateName" class="control-label"></label>
                        <input asp-for="CateName" class="form-control" />
                        <span asp-validation-for="CateName" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="CateStatus" class="control-label"></label>
                        <input asp-for="CateStatus" class="form-control" />
                        <span asp-validation-for="CateStatus" class="text-danger"></span>
                    </div>
                </div>
                <div class="card-footer">

                    <div class="form-group">
                        
                            <a asp-action="NlcEdit" asp-route-id="@Model?.CatId" class="btn btn-danger">Edit</a> |
                        <div>
                            <a asp-action="NlcIndex">Back to List</a>
                        </div>
                    </div>
                </div>
            </div>
    </div>
</div>


